# Deployment-specific values for docker-compose.yml.
# Copy to ".env" (don't commit) and fill in with the real endpoints of the
# Grafana stack for this environment. If a variable is left empty/unset,
# the respective OTLP export is automatically disabled at startup.

OTEL_EXPORTER_OTLP_ENDPOINT=http://<grafana-stack-host>:4318
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://<grafana-stack-host>:3100/otlp/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://<grafana-stack-host>:9090/api/v1/otlp/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://<grafana-stack-host>:4318/v1/traces
